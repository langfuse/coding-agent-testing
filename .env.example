# ---------------------------------------------------------------------------
# internal-ax configuration. Copy to `.env` for local runs; in production these
# live in a Modal Secret named `internal-ax` (see README "Deploy").
# ---------------------------------------------------------------------------

# --- Langfuse (the dataset source AND the trace sink) ----------------------
# Note the v4 env var name is LANGFUSE_BASE_URL (not LANGFUSE_HOST).
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com   # or https://us.cloud.langfuse.com

# --- Model providers -------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- Model selection (override the defaults in config.py) ------------------
# These are deliberately configurable; verify the exact IDs against the
# providers' current model lists before relying on them.
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o

# --- Webhook auth ----------------------------------------------------------
# Langfuse remote-run webhooks carry NO signature/auth header, so we gate the
# endpoint with a shared secret passed as the `?token=` query parameter on the
# webhook URL you register in Langfuse.
WEBHOOK_SECRET=choose-a-long-random-string
