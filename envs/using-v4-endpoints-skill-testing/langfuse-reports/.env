# Dummy credentials for experiment sandboxes — correctly-formatted PLACEHOLDERS,
# not real keys. They exist so agents don't fail with "no credentials configured
# for Langfuse" before they can act. Both LANGFUSE_HOST (CLI / SDK v2-v3) and
# LANGFUSE_BASE_URL (SDK v4) are set so either code path finds a value.
LANGFUSE_PUBLIC_KEY=pk-lf-11111111-1111-1111-1111-111111111111
LANGFUSE_SECRET_KEY=sk-lf-22222222-2222-2222-2222-222222222222
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
